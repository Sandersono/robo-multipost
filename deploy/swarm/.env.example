# Segredos e configuracao do stack Swarm do Robo MultiPost.
#
# Este arquivo e um MODELO, sem valores. O arquivo real vive na VPS em
# /opt/multipost/.env com chmod 600 e nunca e versionado (o .gitignore cobre
# `.env` em qualquer nivel do repositorio).
#
# O stack le do AMBIENTE, nao deste arquivo. Carregue antes de implantar:
#   set -a && . /opt/multipost/.env && set +a
#   docker stack deploy -c /opt/multipost/multipost-stack.yml multipost --with-registry-auth

# Senha do PostgreSQL 17. Usada pelo banco, pelo app e pelo Temporal — que
# hospeda os bancos temporal/temporal_visibility no mesmo servidor.
#   openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_PASSWORD=

# Segredo de assinatura dos JWT de sessao.
#   openssl rand -hex 32
JWT_SECRET=

# Chave da cifra AES-256-GCM dos tokens de canal e das credenciais em repouso.
#
# NUNCA TROQUE depois que o primeiro canal for conectado. Trocar torna ilegivel
# todo token e credencial ja gravados, sem recuperacao: cada canal teria de ser
# reconectado e cada credencial redigitada.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# Postura de registro. Use 'false' apenas o tempo de criar a conta da agencia;
# vire 'true' em seguida — dai em diante a entrada e so por convite.
DISABLE_REGISTRATION=true
